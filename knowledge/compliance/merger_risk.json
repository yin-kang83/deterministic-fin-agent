{
 "card_id": "FIN_RISK_MERGER_001",
 "版本": "1.0",
 "来源": "《商业银行并购贷款风险管理指引》（示例，阈值需以原文核对）",
 "priority": 1,
 "输入": {
  "负债率_百分比": {
   "类型": "数量",
   "单位": "百分数（80 表示 80%）",
   "必填": true
  },
  "现金流": {
   "类型": "金额",
   "必填": true
  },
  "行业": {
   "类型": "文本",
   "必填": true
  }
 },
 "规则": [
  {
   "rule_id": "R1",
   "条件": {
    "op": ">",
    "left": {
     "var": "负债率_百分比"
    },
    "right": {
     "num": 80
    }
   },
   "动作": "FAIL_CLOSED",
   "消息": "标的方负债率超 80%，触发风控熔断"
  },
  {
   "rule_id": "R2",
   "条件": {
    "and": [
     {
      "op": "<",
      "left": {
       "var": "现金流"
      },
      "right": {
       "num": 0
      }
     },
     {
      "op": "==",
      "left": {
       "var": "行业"
      },
      "right": {
       "str": "高污染"
      }
     }
    ]
   },
   "动作": "FAIL_CLOSED",
   "消息": "高污染行业且现金流为负，双重不达标"
  }
 ]
}